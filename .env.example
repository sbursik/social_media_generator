# Comfy.org API key — required for the Gemini (image) and MiniMax (video) API nodes.
# Create one at https://platform.comfy.org (account needs credits).
COMFY_API_KEY=

# ComfyUI server address (default shown)
COMFYUI_URL=http://127.0.0.1:8188

# Backend for image/video generation: comfyui (default) or direct.
# direct calls Gemini and MiniMax straight, so no ComfyUI is needed (e.g. on Windows),
# but it bills those accounts instead of Comfy.org credits.
BACKEND=comfyui
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MiniMax platform key: https://platform.minimax.io
MINIMAX_API_KEY=
