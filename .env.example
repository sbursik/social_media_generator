# ComfyUI server address (default shown)
COMFYUI_URL=http://127.0.0.1:8188

# local (default) runs MiniMax H3 on your GPU through ComfyUI, with no API keys or credits.
# The paid cloud options are comfyui (Comfy.org credits) and direct (no ComfyUI, e.g. on Windows).
IMAGE_BACKEND=local
VIDEO_BACKEND=local

# Keys below are only needed for the cloud options.
# BACKEND=direct makes direct the default for any backend above that's unset.
BACKEND=
# Comfy.org key for comfyui: https://platform.comfy.org (account needs credits)
COMFY_API_KEY=
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MiniMax platform key: https://platform.minimax.io
MINIMAX_API_KEY=
